<Project>
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Necessário para o analisador de usings sem uso (IDE0005); avisos de documentação desligados. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1574;CS1587</NoWarn>
  </PropertyGroup>
</Project>
