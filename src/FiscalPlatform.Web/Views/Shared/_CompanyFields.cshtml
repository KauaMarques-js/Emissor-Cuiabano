@model CompanyInput
@{
    var step = (int?)ViewData["FirstStep"] ?? 1;
    string Name(string field) => ViewData.TemplateInfo.GetFullHtmlFieldName(field);
    string Id(string field) => Html.GenerateIdFromName(Name(field));
    var simples = $"{Name(nameof(CompanyInput.TaxRegime))}={TaxRegime.SimplesNacional}|{TaxRegime.SimplesNacionalExcesso}";
}

<section class="section" data-lookup-scope>
    <h2><span class="step">@step</span> Sua empresa</h2>
    <div class="row g-2">
        <div class="col-md-5">
            <label asp-for="Cnpj" class="form-label">CNPJ</label>
            <div class="input-group">
                <input asp-for="Cnpj" class="form-control" data-mask="cnpj" data-lookup="cnpj" inputmode="numeric" required />
                <button type="button" class="btn btn-outline-secondary" data-lookup-button="cnpj">Buscar dados</button>
            </div>
            <span asp-validation-for="Cnpj" class="text-danger small"></span>
        </div>
        <div class="col-md-7 d-flex align-items-end"><div class="lookup-status" data-lookup-status="cnpj" aria-live="polite">Digite o CNPJ: preenchemos razão social, endereço e regime para você.</div></div>
        <div class="col-md-7"><label asp-for="LegalName" class="form-label">Razão social</label><input asp-for="LegalName" class="form-control" data-field="name" required /><span asp-validation-for="LegalName" class="text-danger small"></span></div>
        <div class="col-md-5"><label asp-for="TradeName" class="form-label">Nome fantasia <span class="hint">(opcional)</span></label><input asp-for="TradeName" class="form-control" data-field="tradeName" /></div>
        <div class="col-md-6">
            <label asp-for="TaxRegime" class="form-label">Regime tributário</label>
            <select asp-for="TaxRegime" class="form-select" data-field="taxRegime" required>
                <option value="">Escolha…</option>
                <option value="@TaxRegime.Mei">MEI</option>
                <option value="@TaxRegime.SimplesNacional">Simples Nacional (ME/EPP)</option>
                <option value="@TaxRegime.SimplesNacionalExcesso">Simples Nacional com ISS/ICMS fora do Simples (excesso de sublimite)</option>
                <option value="@TaxRegime.RegimeNormal">Fora do Simples (Lucro Presumido ou Real)</option>
            </select>
            <span asp-validation-for="TaxRegime" class="text-danger small"></span>
        </div>
        <div class="col-6 col-md-3"><label asp-for="MunicipalRegistration" class="form-label">Inscrição municipal</label><input asp-for="MunicipalRegistration" class="form-control" /></div>
        <div class="col-6 col-md-3"><label asp-for="StateRegistration" class="form-label">Inscrição estadual</label><input asp-for="StateRegistration" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Email" class="form-label">E-mail da empresa</label><input asp-for="Email" type="email" class="form-control" data-field="email" /></div>
        <div class="col-md-6"><label asp-for="Phone" class="form-label">Telefone</label><input asp-for="Phone" class="form-control" data-mask="phone" data-field="phone" inputmode="tel" /></div>
    </div>
    <h3 class="h6 mt-3">Endereço</h3>
    <partial name="_AddressFields" for="Address" />
</section>

<section class="section">
    <h2><span class="step">@(step + 1)</span> O que você vai emitir</h2>
    <label class="choice"><input asp-for="IssuesNfse" class="form-check-input me-2" /> <strong>NFS-e: nota de serviço</strong>
        <small>Pelo Emissor Nacional (obrigatório em Cuiabá desde 01/11/2026).</small></label>
    <label class="choice"><input asp-for="IssuesNfe" class="form-check-input me-2" /> <strong>NF-e: nota de produto</strong>
        <small>Por enquanto só em simulação; a emissão oficial de NF-e ainda não está disponível.</small></label>
    <span asp-validation-for="IssuesNfse" class="text-danger small"></span>

    <div data-show-if="@Name(nameof(CompanyInput.IssuesNfse))=true" class="mt-3">
        <h3 class="h6">Como emitir as NFS-e</h3>
        <label class="choice"><input type="radio" asp-for="NfseMode" value="@EmissionMode.Simulacao" class="form-check-input me-2" /> <strong>Simulação</strong>
            <small>Para conhecer o sistema. Nada é enviado ao governo; as notas não valem.</small></label>
        <label class="choice"><input type="radio" asp-for="NfseMode" value="@EmissionMode.Homologacao" class="form-check-input me-2" /> <strong>Teste no governo (homologação)</strong>
            <small>Envia ao Emissor Nacional, mas as notas não têm validade jurídica. Recomendado antes de começar a valer. Exige o certificado.</small></label>
        <label class="choice"><input type="radio" asp-for="NfseMode" value="@EmissionMode.Producao" class="form-check-input me-2" /> <strong>Valendo (produção)</strong>
            <small>Notas reais, com validade jurídica. Exige o certificado.</small></label>

        <div class="row g-2 mt-1">
            <div class="col-md-6" data-show-if="@simples">
                <label asp-for="NfseSimplesTaxPercent" class="form-label">Alíquota efetiva do Simples (%)</label>
                <input asp-for="NfseSimplesTaxPercent" class="form-control" inputmode="decimal" placeholder="ex.: 6,00" />
                <div class="hint">Vai na nota como total aproximado de tributos. Seu contador informa o valor.</div>
            </div>
            <div class="col-md-6" data-show-if="@Name(nameof(CompanyInput.TaxRegime))=@TaxRegime.RegimeNormal">
                <label class="form-label" for="@Id(nameof(CompanyInput.NfseFederalTaxPercent))">Tributos aproximados (%)</label>
                <div class="input-group">
                    <span class="input-group-text">Federais</span><input asp-for="NfseFederalTaxPercent" class="form-control" inputmode="decimal" />
                    <span class="input-group-text">Municipais</span><input asp-for="NfseMunicipalTaxPercent" class="form-control" inputmode="decimal" aria-label="Tributos municipais (%)" />
                </div>
                <div class="hint">Lei 12.741/2012. Seu contador informa os valores.</div>
            </div>
        </div>
    </div>

    <details class="mt-3">
        <summary>Numeração e opções avançadas</summary>
        <div class="row g-2 mt-1">
            <div class="col-6 col-md-3"><label asp-for="NfseSeries" class="form-label">Série NFS-e</label><input asp-for="NfseSeries" class="form-control" /></div>
            <div class="col-6 col-md-3"><label asp-for="NfseNextNumber" class="form-label">Próximo nº NFS-e</label><input asp-for="NfseNextNumber" class="form-control" /></div>
            <div class="col-6 col-md-3"><label asp-for="NfeSeries" class="form-label">Série NF-e</label><input asp-for="NfeSeries" class="form-control" /></div>
            <div class="col-6 col-md-3"><label asp-for="NfeNextNumber" class="form-label">Próximo nº NF-e</label><input asp-for="NfeNextNumber" class="form-control" /></div>
            <div class="col-md-6">
                <label asp-for="NfseSpecialRegime" class="form-label">Regime especial de ISS</label>
                <select asp-for="NfseSpecialRegime" class="form-select">
                    <option value="0">Nenhum</option>
                    <option value="1">Cooperativa (ato cooperado)</option>
                    <option value="2">Estimativa</option>
                    <option value="3">Microempresa municipal</option>
                    <option value="4">Notário ou registrador</option>
                    <option value="5">Profissional autônomo</option>
                    <option value="6">Sociedade de profissionais</option>
                    <option value="9">Outros</option>
                </select>
            </div>
            <p class="hint col-12 mb-0">Só altere a numeração se já emitiu notas por outro sistema nesta mesma série. Repetir um número faz a nota ser rejeitada.</p>
        </div>
    </details>
</section>

<section class="section">
    <h2><span class="step">@(step + 2)</span> Certificado digital A1</h2>
    <p class="hint">Necessário para emitir de verdade. Fica guardado criptografado neste computador e nunca é exibido nem baixado.
        Se ainda não tiver, deixe em branco e use a simulação.</p>
    <div class="row g-2">
        <div class="col-md-7">
            <label asp-for="CertificateFile" class="form-label">Arquivo do certificado (.pfx ou .p12)</label>
            <input asp-for="CertificateFile" type="file" accept=".pfx,.p12" class="form-control" />
            <span asp-validation-for="CertificateFile" class="text-danger small"></span>
        </div>
        <div class="col-md-5">
            <label asp-for="CertificatePassword" class="form-label">Senha do certificado</label>
            <input asp-for="CertificatePassword" type="password" class="form-control" autocomplete="off" />
        </div>
    </div>
</section>
