@model List<BatchSummary>
@{ ViewData["Title"] = "Lotes de emissão"; }
<h1>Lotes de emissão</h1>
<p class="small text-muted">Para criar um lote, vá em <a asp-controller="Documents" asp-action="Index">Notas</a>, marque os rascunhos e clique em "Preparar lote".</p>
<table class="table table-sm table-hover">
    <thead><tr><th>Lote</th><th>Criado</th><th>Tipo</th><th>Ambiente</th><th>Situação</th><th>Total</th><th>Autorizadas</th><th>Rejeitadas</th><th>Pendentes/falhas</th><th>Não enviadas</th><th>Usuário</th></tr></thead>
    <tbody>
        @foreach (var s in Model)
        {
            int C(params BatchItemStatus[] st) => st.Sum(x => s.Counts.TryGetValue(x, out var c) ? c : 0);
            <tr>
                <td><a asp-action="Details" asp-route-id="@s.Batch.Id">#@s.Batch.Id</a></td>
                <td class="small">@Ui.Date(s.Batch.CreatedAt)</td>
                <td>@Ui.TypeLabel(s.Batch.DocumentType)</td>
                <td class="small">@Ui.Label(s.Batch.Environment) / @Ui.Label(s.Batch.Provider)</td>
                <td>@Ui.Label(s.Batch.Status)</td>
                <td>@s.Batch.Items.Count</td>
                <td>@C(BatchItemStatus.Autorizada)</td>
                <td>@C(BatchItemStatus.Rejeitada)</td>
                <td>@C(BatchItemStatus.PendenteConsulta, BatchItemStatus.FalhaComunicacao)</td>
                <td>@C(BatchItemStatus.NaoEnviado)</td>
                <td class="small">@s.Batch.CreatedBy</td>
            </tr>
        }
    </tbody>
</table>
